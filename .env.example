# ============================================================================
# AI News Daily — Configuration (.env)
# Copy this file to .env and fill in the credentials you want to use.
# ============================================================================

# --- Gemini API (Optional but recommended for AI executive summaries) ---
# Get an API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Discord Notification (Webhook) ---
# Create a webhook in Discord: Server Settings -> Integrations -> Webhooks -> New Webhook
DISCORD_WEBHOOK_URL=

# --- Email Notification (Option A: Resend API) ---
# If set, Resend API (https://resend.com) will be used to send HTML emails
RESEND_API_KEY=

# --- Email Notification (Option B: Standard SMTP / Gmail App Password) ---
# For Gmail, use smtp.gmail.com, port 587, and a 16-char Google App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# --- Aggregation Settings ---
LOOKBACK_HOURS=24
MAX_ITEMS_PER_SOURCE=5
